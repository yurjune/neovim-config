# Include Hidden paths
!.env
!.env.*
!.github/
!.gitignore

# Exclude
## VCS / dependencies
.git/
node_modules/
.pnpm-store/

## TypeScript artifacts
*.tsbuildinfo

## Build outputs
dist/
build/
out/
coverage/

## Framework / tooling caches
.next/
.nuxt/
.svelte-kit/
.turbo/
.vite/
.cache/
.eslintcache

## Logs / OS files
*.log
.DS_Store
